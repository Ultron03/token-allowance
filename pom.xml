<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
	child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.ultron03</groupId>
	<artifactId>token-allowance-parent</artifactId>
	<version>0.1.1</version>
	<packaging>pom</packaging>
	<modules>
		<module>token-allowance-core</module>
		<module>token-allowance-redis</module>
		<module>token-allowance-autoconfigure</module>
		<module>token-allowance-spring-ai</module>
		<module>token-allowance-spring-boot-starter</module>
	</modules>
	<name>Token Allowance Parent</name>
	<description>Token and cost budgets for Spring AI calls.</description>
	<url>https://github.com/Ultron03/token-allowance</url>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>Ultron03</id>
			<name>Ultron03</name>
			<url>https://github.com/Ultron03</url>
		</developer>
	</developers>
	<scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false"
		child.scm.url.inherit.append.path="false">
		<connection>scm:git:https://github.com/Ultron03/token-allowance.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/Ultron03/token-allowance.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/Ultron03/token-allowance</url>
	</scm>
	<properties>
		<maven.compiler.release>17</maven.compiler.release>
		<spring-boot.version>4.1.1</spring-boot.version>
		<spring-ai.version>2.0.1</spring-ai.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.github.ultron03</groupId>
				<artifactId>token-allowance-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.ultron03</groupId>
				<artifactId>token-allowance-spring-ai</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.ultron03</groupId>
				<artifactId>token-allowance-autoconfigure</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.ultron03</groupId>
				<artifactId>token-allowance-redis</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.ultron03</groupId>
				<artifactId>token-allowance-spring-boot-starter</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<profile>
			<!-- Builds sources and javadoc jars, signs everything and uploads it to Maven Central. -->
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.4.0</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.12.0</version>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.12.0</version>
						<extensions>true</extensions>
						<configuration>
							<publishingServerId>central</publishingServerId>
							<!-- Upload and validate only; the release is published by hand in the Central Portal. -->
							<autoPublish>false</autoPublish>
							<excludeArtifacts>
								<!-- Empty until the Redis ledger is written. -->
								<artifact>token-allowance-redis</artifact>
							</excludeArtifacts>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
