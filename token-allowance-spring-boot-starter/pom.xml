<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.ultron03</groupId>
    <artifactId>token-allowance-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>token-allowance-spring-boot-starter</artifactId>
  <name>Token Allowance Spring Boot Starter</name>
  <description>Add this one dependency to enforce token and cost budgets on Spring AI ChatClient calls.</description>

  <dependencies>
      <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
      </dependency>
      <dependency>
            <!-- The properties are @Validated, and Boot fails at startup when the validation API is present without an implementation. -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
      </dependency>
      <dependency>
            <groupId>io.github.ultron03</groupId>
            <artifactId>token-allowance-autoconfigure</artifactId>
      </dependency>
  </dependencies>

  <profiles>
      <profile>
            <!-- The starter has no code, but Maven Central requires sources and javadoc jars for every jar. -->
            <id>release</id>
            <build>
                  <plugins>
                        <plugin>
                              <groupId>org.apache.maven.plugins</groupId>
                              <artifactId>maven-jar-plugin</artifactId>
                              <version>3.5.1</version>
                              <executions>
                                    <execution>
                                          <id>empty-sources-jar</id>
                                          <phase>package</phase>
                                          <goals>
                                                <goal>jar</goal>
                                          </goals>
                                          <configuration>
                                                <classifier>sources</classifier>
                                          </configuration>
                                    </execution>
                                    <execution>
                                          <id>empty-javadoc-jar</id>
                                          <phase>package</phase>
                                          <goals>
                                                <goal>jar</goal>
                                          </goals>
                                          <configuration>
                                                <classifier>javadoc</classifier>
                                          </configuration>
                                    </execution>
                              </executions>
                        </plugin>
                  </plugins>
            </build>
      </profile>
  </profiles>
</project>
